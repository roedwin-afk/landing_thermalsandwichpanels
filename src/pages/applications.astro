---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations, getAlternatePath } from "../i18n/utils";
import ApplicationsFull from "../components/sections/ApplicationsFull.astro";
import { ArrowLeft } from "lucide-astro";
import JsonLd from "../components/ui/JsonLd.astro";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);
const alternateURL = new URL(getAlternatePath(Astro.url, base), Astro.site).href;
---

<Layout
  t={t}
  lang={lang}
  alternateURL={alternateURL}
  title="Applications | Thermal Sandwich Panels"
  description="Discover how thermal sandwich panels perform across industrial warehouses, cold storage, residential eco-housing, agriculture, and commercial facades."
>
<JsonLd
  lang={lang}
  type="page"
  title="Applications | Thermal Sandwich Panels"
  description={t.applications_page.description}
  url={Astro.url.href}
/>
  <div class="apps-page">

    <!-- Hero -->
    <div class="apps-page__hero">
      <div class="apps-page__hero-radial"></div>
      <div class="container">
        <a href={base} class="apps-page__back">
          <ArrowLeft size={16} />
          {t.applications_page.backToHome}
        </a>
        <span class="section-label">{t.applications_page.label}</span>
        <h1 class="apps-page__title">{t.applications_page.title}</h1>
        <p class="apps-page__description">{t.applications_page.description}</p>
      </div>
    </div>

    <!-- Content -->
    <div class="apps-page__body">
      <div class="container">
        <ApplicationsFull t={t} lang={lang} />
      </div>
    </div>

    <!-- CTA -->
    <div class="apps-page__cta">
      <div class="container">
        <div class="apps-page__cta-inner">
          <h2 class="apps-page__cta-title">{t.applications_page.ctaTitle}</h2>
          <p class="apps-page__cta-text">{t.applications_page.ctaText}</p>
          <a href={`${base}contact`} class="apps-page__cta-btn">
            {t.applications_page.ctaButton}
          </a>
        </div>
      </div>
    </div>

  </div>
</Layout>

<style>
  .apps-page__hero {
    position: relative;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-slate-900) 100%
    );
    padding-top: 8rem;
    padding-bottom: var(--space-16);
    overflow: hidden;
  }

  .apps-page__hero-radial {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at top right,
      rgba(249, 115, 22, 0.1),
      transparent 60%
    );
    pointer-events: none;
  }

  .apps-page__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-slate-300);
    margin-bottom: var(--space-6);
    transition: color var(--transition-base);
  }

  .apps-page__back:hover {
    color: var(--color-white);
  }

  .apps-page__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-white);
    margin-top: var(--space-2);
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .apps-page__title {
      font-size: var(--text-4xl);
    }
  }

  .apps-page__description {
    color: var(--color-slate-300);
    font-size: var(--text-base);
    margin-top: var(--space-4);
    max-width: 40rem;
    line-height: 1.75;
  }

  .apps-page__body {
    padding-block: var(--space-20);
    background-color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .apps-page__body {
      padding-block: var(--space-28);
    }
  }

  .apps-page__cta {
    background-color: var(--color-slate-50);
    border-top: 1px solid var(--color-slate-100);
    padding-block: var(--space-16);
  }

  .apps-page__cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    max-width: 36rem;
    margin-inline: auto;
  }

  .apps-page__cta-title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-2xl);
    color: var(--color-slate-900);
  }

  .apps-page__cta-text {
    color: var(--color-slate-600);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  .apps-page__cta-btn {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-accent);
    color: var(--color-white);
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    padding: 0.875rem 2rem;
    border-radius: var(--radius-lg);
    transition: background-color var(--transition-base), transform var(--transition-base);
    box-shadow: 0 8px 24px rgba(249, 115, 22, 0.2);
    margin-top: var(--space-2);
  }

  .apps-page__cta-btn:hover {
    background-color: var(--color-accent-dark);
    transform: translateY(-2px);
  }
</style>