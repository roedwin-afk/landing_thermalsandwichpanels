---
import Layout from "../layouts/Layout.astro";
import { getLang, useTranslations, getAlternatePath } from "../i18n/utils";
import { Home, ArrowLeft, Search } from "lucide-astro";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);
const alternateURL = new URL(getAlternatePath(Astro.url, base), Astro.site).href;
---

<Layout
  t={t}
  lang={lang}
  alternateURL={alternateURL}
  title="404 — Page Not Found | Thermal Sandwich Panels"
  description="The page you are looking for does not exist."
>
  <section class="not-found">
    <div class="not-found__deco not-found__deco--tr"></div>
    <div class="not-found__deco not-found__deco--bl"></div>

    <div class="container">
      <div class="not-found__inner">

        <!-- 404 Number -->
        <div class="not-found__number" aria-hidden="true">404</div>

        <!-- Icon -->
        <div class="not-found__icon">
          <Search size={40} />
        </div>

        <!-- Text -->
        <h1 class="not-found__title">
          {lang === "en" ? "Page Not Found" : "Página No Encontrada"}
        </h1>
        <p class="not-found__description">
          {lang === "en"
            ? "The page you are looking for doesn't exist or has been moved."
            : "La página que buscas no existe o ha sido movida."}
        </p>

        <!-- CTAs -->
        <div class="not-found__actions">
          <a href={base} class="not-found__btn not-found__btn--primary">
            <Home size={16} />
            {lang === "en" ? "Back to Home" : "Volver al Inicio"}
          </a>
          
            href="javascript:history.back()"
            class="not-found__btn not-found__btn--secondary"
          >
            <ArrowLeft size={16} />
            {lang === "en" ? "Go Back" : "Regresar"}
          </a>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-slate-900) 100%
    );
    overflow: hidden;
    padding-block: var(--space-20);
  }

  /* Deco blobs */
  .not-found__deco {
    position: absolute;
    width: 24rem;
    height: 24rem;
    border-radius: var(--radius-full);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .not-found__deco--tr {
    top: -4rem;
    right: -4rem;
    background-color: rgba(249, 115, 22, 0.1);
  }

  .not-found__deco--bl {
    bottom: -4rem;
    left: -4rem;
    background-color: rgba(29, 78, 216, 0.15);
  }

  /* Inner */
  .not-found__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    max-width: 36rem;
    margin-inline: auto;
  }

  /* 404 number */
  .not-found__number {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: 8rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.1);
    user-select: none;
    letter-spacing: -0.05em;
  }

  @media (min-width: 640px) {
    .not-found__number {
      font-size: 12rem;
    }
  }

  /* Icon */
  .not-found__icon {
    width: 5rem;
    height: 5rem;
    background-color: rgba(249, 115, 22, 0.15);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: var(--radius-2xl);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    margin-top: calc(var(--space-16) * -1);
  }

  /* Title */
  .not-found__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-white);
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .not-found__title {
      font-size: var(--text-4xl);
    }
  }

  /* Description */
  .not-found__description {
    font-size: var(--text-base);
    color: var(--color-slate-300);
    line-height: 1.7;
    max-width: 28rem;
  }

  /* Actions */
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-4);
  }

  .not-found__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .not-found__btn--primary {
    background-color: var(--color-accent);
    color: var(--color-white);
    box-shadow: 0 8px 24px rgba(249, 115, 22, 0.25);
  }

  .not-found__btn--primary:hover {
    background-color: var(--color-accent-dark);
    transform: translateY(-2px);
  }

  .not-found__btn--secondary {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    backdrop-filter: blur(4px);
  }

  .not-found__btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }
</style>