---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
  currentPath?: string;
  orientation?: "horizontal" | "vertical";
}

const {
  t,
  lang,
  currentPath = "",
  orientation = "horizontal",
} = Astro.props;

const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}#que-es`,     label: t.nav.what },
  { href: `${base}#beneficios`, label: t.nav.benefits },
  { href: `${base}#guia`,       label: t.nav.guide },
  { href:`${base}#comparativa`,label: t.nav.comparison },
  { href: `${base}#faq`,        label: t.nav.faq },
  { href: `${base}blog`,        label: t.nav.blog },
];
---

<ul class:list={["nav-links", `nav-links--${orientation}`]}>
  {links.map((link) => (
    <li>
      
     <a   href={link.href}
        class:list={["nav-link", { "nav-link--active": currentPath === link.href }]}
      >
        {link.label}
      </a>
    </li>
  ))}
</ul>

<style>
  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links--horizontal {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-links--vertical {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-slate-700);
    transition: color var(--transition-base);
    white-space: nowrap;
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-accent);
    border-radius: 2px;
    transition: width var(--transition-slow) ease;
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    width: 100%;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-primary-mid);
  }

  /* Vertical variant (mobile menu) */
  .nav-links--vertical .nav-link {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--color-slate-700);
  }

  .nav-links--vertical .nav-link:hover {
    background-color: var(--color-slate-100);
    color: var(--color-primary-mid);
  }
</style>