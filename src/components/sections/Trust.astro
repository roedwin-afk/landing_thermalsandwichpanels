---
import { Quote } from "lucide-astro";
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t } = Astro.props;

const stats = [
  { value: t.trust.stat1Value, label: t.trust.stat1Label },
  { value: t.trust.stat2Value, label: t.trust.stat2Label },
  { value: t.trust.stat3Value, label: t.trust.stat3Label },
  { value: t.trust.stat4Value, label: t.trust.stat4Label },
];

const testimonials = [
  {
    initials: "MA",
    name: t.trust.t1Name,
    role: t.trust.t1Role,
    text: t.trust.t1Text,
    accent: false,
  },
  {
    initials: "EP",
    name: t.trust.t2Name,
    role: t.trust.t2Role,
    text: t.trust.t2Text,
    accent: true,
  },
];
---

<section class="trust">
  <div class="container">

    <!-- Stats -->
    <div class="trust__stats">
      {stats.map((stat, i) => (
        <div class={`trust__stat reveal reveal-delay-${i + 1}`}>
          <span class="trust__stat-value">{stat.value}</span>
          <span class="trust__stat-label">{stat.label}</span>
        </div>
      ))}
    </div>

    <!-- Testimonials Header -->
    <div class="trust__testimonials-header reveal">
      <span class="section-label">{t.trust.testimonialsLabel}</span>
      <h2 class="trust__testimonials-title">{t.trust.testimonialsTitle}</h2>
    </div>

    <!-- Testimonials Grid -->
    <div class="trust__testimonials">
      {testimonials.map((t, i) => (
        <div class={`trust__testimonial reveal reveal-delay-${i + 1}`}>
          <Quote size={40} class="trust__quote-icon" />

          <div class="trust__testimonial-author">
            <div class={`trust__testimonial-avatar ${t.accent ? "trust__testimonial-avatar--accent" : ""}`}>
              {t.initials}
            </div>
            <div>
              <span class="trust__testimonial-name">{t.name}</span>
              <span class="trust__testimonial-role">{t.role}</span>
            </div>
          </div>

          <p class="trust__testimonial-text">"{t.text}"</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .trust {
    padding-block: var(--space-20);
    background-color: var(--color-slate-100);
  }

  /* Stats */
  .trust__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-20);
  }

  @media (min-width: 768px) {
    .trust__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trust__stat {
    background-color: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-2xl);
    border: 1px solid rgba(226, 232, 240, 0.6);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .trust__stat-value {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-4xl);
    color: var(--color-primary-mid);
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  @media (min-width: 640px) {
    .trust__stat-value {
      font-size: var(--text-5xl);
    }
  }

  .trust__stat-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate-600);
  }

  /* Testimonials header */
  .trust__testimonials-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .trust__testimonials-title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-slate-900);
    margin-top: var(--space-2);
  }

  /* Testimonials grid */
  .trust__testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    max-width: 64rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .trust__testimonials {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Testimonial card */
  .trust__testimonial {
    position: relative;
    background-color: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    border: 1px solid rgba(226, 232, 240, 0.6);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .trust__quote-icon {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    color: var(--color-slate-200);
  }

  .trust__testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .trust__testimonial-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }

  .trust__testimonial-avatar--accent {
    background-color: var(--color-accent);
  }

  .trust__testimonial-name {
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--color-slate-900);
    font-size: var(--text-base);
  }

  .trust__testimonial-role {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-slate-500);
    margin-top: var(--space-1);
  }

  .trust__testimonial-text {
    color: var(--color-slate-600);
    font-size: var(--text-sm);
    line-height: 1.75;
    font-style: italic;
  }
</style>