---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
---

<section id="inicio" class="hero">
  <!-- Background Image with Overlay -->
  <div class="hero__bg">
    <img
      src="https://images.unsplash.com/photo-1581094288338-2314dddb7ece?auto=format&fit=crop&w=1920&q=80"
      alt="Modern industrial insulated construction"
      class="hero__bg-img"
      loading="eager"
    />
    <div class="hero__bg-overlay"></div>
  </div>

  <div class="container">
    <div class="hero__inner">

      <!-- Left Content -->
      <div class="hero__content">
        <div class="hero__badge reveal">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          {t.hero.badge}
        </div>

        <h1 class="hero__title reveal reveal-delay-1">
          {t.hero.title}
        </h1>

        <p class="hero__subtitle reveal reveal-delay-2">
          {t.hero.subtitle}
        </p>

        <!-- Feature List -->
        <ul class="hero__features reveal reveal-delay-3">
          <li class="hero__feature">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {t.hero.feature1}
          </li>
          <li class="hero__feature">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {t.hero.feature2}
          </li>
          <li class="hero__feature">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {t.hero.feature3}
          </li>
          <li class="hero__feature">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {t.hero.feature4}
          </li>
        </ul>

        <!-- CTA Buttons -->
        <div class="hero__ctas reveal reveal-delay-4">
          <a href="#contacto" class="hero__cta-primary">
            {t.hero.ctaPrimary}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
          <a href="#que-es" class="hero__cta-secondary">
            {t.hero.ctaSecondary}
          </a>
        </div>
      </div>

      <!-- Right Card -->
      <div class="hero__card reveal reveal-delay-3">
        <div class="hero__card-header">
          <div class="hero__card-number">{t.hero.card.label}</div>
          <div class="hero__card-heading">
            <h3>{t.hero.card.title}</h3>
            <p>{t.hero.card.subtitle}</p>
          </div>
        </div>

        <div class="hero__card-items">
          <div class="hero__card-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <div>
              <h4>{t.hero.card.item1Title}</h4>
              <p>{t.hero.card.item1Text}</p>
            </div>
          </div>
          <div class="hero__card-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 22 16 8M3.5 6.5 6 9l4-4-3-3L3.5 6.5z"/>
              <path d="m14 3 3.5 3.5-8 8L6 11l8-8z"/>
              <path d="m17.5 6.5 3 3-8 8-3-3 8-8z"/>
              <path d="m21 14-3 3-1.5-1.5 3-3L21 14z"/>
            </svg>
            <div>
              <h4>{t.hero.card.item2Title}</h4>
              <p>{t.hero.card.item2Text}</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    overflow: hidden;
    background-color: var(--color-slate-900);
  }

  /* Background */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.4;
  }

  .hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(30, 58, 138, 0.92) 0%,
      rgba(17, 24, 39, 0.85) 100%
    );
  }

  /* Inner layout */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16);
  }

  /* Badge */
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: rgba(249, 115, 22, 0.2);
    color: var(--color-accent);
    border: 1px solid rgba(249, 115, 22, 0.3);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Title */
  .hero__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-white);
    line-height: 1.2;
    margin-top: var(--space-4);
  }

  /* Subtitle */
  .hero__subtitle {
    font-size: var(--text-lg);
    color: #e2e8f0;
    font-weight: var(--font-light);
    line-height: 1.7;
    max-width: 36rem;
    margin-top: var(--space-4);
  }

  /* Features */
  .hero__features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
    max-width: 28rem;
  }

  .hero__feature {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: #e2e8f0;
  }

  .hero__feature svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* CTAs */
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-accent);
    color: var(--color-white);
    font-weight: var(--font-bold);
    padding: 1rem 2rem;
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px rgba(249, 115, 22, 0.25);
    transition: background-color var(--transition-base), transform var(--transition-base);
  }

  .hero__cta-primary:hover {
    background-color: var(--color-accent-dark);
    transform: translateY(-2px);
  }

  .hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-white);
    font-weight: var(--font-semibold);
    padding: 1rem 2rem;
    border-radius: var(--radius-lg);
    backdrop-filter: blur(4px);
    transition: background-color var(--transition-base);
  }

  .hero__cta-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* Right Card */
  .hero__card {
    display: none;
    background-color: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-2xl);
  }

  .hero__card-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .hero__card-number {
    background-color: var(--color-accent);
    color: var(--color-white);
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-bold);
    font-size: var(--text-xl);
    flex-shrink: 0;
  }

  .hero__card-heading h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--color-white);
    font-size: var(--text-base);
  }

  .hero__card-heading p {
    font-size: var(--text-xs);
    color: #cbd5e1;
    margin-top: var(--space-1);
  }

  .hero__card-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero__card-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .hero__card-item svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .hero__card-item h4 {
    font-weight: var(--font-semibold);
    color: var(--color-white);
    font-size: var(--text-sm);
  }

  .hero__card-item p {
    font-size: var(--text-xs);
    color: #cbd5e1;
    margin-top: var(--space-1);
    line-height: 1.5;
  }

  /* Responsive */
  @media (min-width: 640px) {
    .hero__title {
      font-size: var(--text-4xl);
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 7fr 5fr;
      padding-block: var(--space-24);
    }

    .hero__title {
      font-size: var(--text-5xl);
    }

    .hero__card {
      display: block;
    }
  }
</style>