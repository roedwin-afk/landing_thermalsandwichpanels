---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;

const benefits = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    title: t.benefits.b1Title,
    text: t.benefits.b1Text,
    accent: true,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>`,
    title: t.benefits.b2Title,
    text: t.benefits.b2Text,
    accent: false,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>`,
    title: t.benefits.b3Title,
    text: t.benefits.b3Text,
    accent: true,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    title: t.benefits.b4Title,
    text: t.benefits.b4Text,
    accent: false,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>`,
    title: t.benefits.b5Title,
    text: t.benefits.b5Text,
    accent: true,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: t.benefits.b6Title,
    text: t.benefits.b6Text,
    accent: false,
  },
];
---

<section id="beneficios" class="benefits">
  <div class="container">

    <!-- Header -->
    <div class="benefits__header reveal">
      <span class="section-label">{t.benefits.label}</span>
      <h2 class="benefits__title accent-line-center">{t.benefits.title}</h2>
      <p class="benefits__description">{t.benefits.description}</p>
    </div>

    <!-- Cards Grid -->
    <div class="benefits__grid">
      {benefits.map((benefit, i) => (
        <div class={`benefits__card reveal reveal-delay-${(i % 3) + 1}`}>
          <div class={`benefits__card-icon ${benefit.accent ? "benefits__card-icon--accent" : "benefits__card-icon--primary"}`}>
            <Fragment set:html={benefit.icon} />
          </div>
          <h3 class="benefits__card-title">{benefit.title}</h3>
          <p class="benefits__card-text">{benefit.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .benefits {
    padding-block: var(--space-20);
    background-color: var(--color-slate-50);
    border-top: 1px solid var(--color-slate-100);
    border-bottom: 1px solid var(--color-slate-100);
  }

  /* Header */
  .benefits__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .benefits__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-slate-900);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .benefits__title {
      font-size: var(--text-4xl);
    }
  }

  .benefits__description {
    color: var(--color-slate-600);
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }

  /* Grid */
  .benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .benefits__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .benefits__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card */
  .benefits__card {
    background-color: var(--color-white);
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-slate-100);
    transition:
      box-shadow var(--transition-slow),
      transform var(--transition-slow);
  }

  .benefits__card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .benefits__card-icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .benefits__card-icon--accent {
    background-color: #fff7ed;
    color: var(--color-accent);
  }

  .benefits__card-icon--primary {
    background-color: #eff6ff;
    color: var(--color-primary-mid);
  }

  .benefits__card-title {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    color: var(--color-slate-900);
    margin-bottom: var(--space-3);
  }

  .benefits__card-text {
    color: var(--color-slate-600);
    font-size: var(--text-sm);
    line-height: 1.75;
  }
</style>