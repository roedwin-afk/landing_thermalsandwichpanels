---
import { Thermometer, Zap, Clock, Shield } from "lucide-astro";
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
---

<section id="que-es" class="what">
  <div class="container">
    <!-- Header -->
    <div class="what__header reveal">
      <span class="section-label">{t.what.label}</span>
      <h2 class="what__title accent-line-center">{t.what.title}</h2>
      <p class="what__description">{t.what.description}</p>
    </div>

    <!-- Content Grid -->
    <div class="what__grid">
      <!-- Left: Image -->
      <div class="what__image-wrap reveal">
        <div class="what__image-deco what__image-deco--tl"></div>
        <div class="what__image-deco what__image-deco--br"></div>
        <img
          src="https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=800&q=80"
          alt="Steel structures and insulated panels in modern construction sites"
          class="what__image"
          loading="lazy"
        />
      </div>

      <!-- Right: Text + Cards -->
      <div class="what__content">
        <h3 class="what__heading reveal">{t.what.heading}</h3>
        <p class="what__body reveal reveal-delay-1">{t.what.body}</p>

        <div class="what__cards">
          <div class="what__card reveal reveal-delay-1">
            <div class="what__card-icon"><Thermometer size={20} /></div>
            <div>
              <h4>{t.what.card1Title}</h4>
              <p>{t.what.card1Text}</p>
            </div>
          </div>

          <div class="what__card reveal reveal-delay-2">
            <div class="what__card-icon"><Zap size={20} /></div>
            <div>
              <h4>{t.what.card2Title}</h4>
              <p>{t.what.card2Text}</p>
            </div>
          </div>

          <div class="what__card reveal reveal-delay-3">
            <div class="what__card-icon"><Clock size={20} /></div>
            <div>
              <h4>{t.what.card3Title}</h4>
              <p>{t.what.card3Text}</p>
            </div>
          </div>

          <div class="what__card reveal reveal-delay-4">
            <div class="what__card-icon"><Shield size={20} /></div>
            <div>
              <h4>{t.what.card4Title}</h4>
              <p>{t.what.card4Text}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .what {
    padding-block: var(--space-20);
    background-color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .what {
      padding-block: var(--space-28);
    }
  }

  /* Header */
  .what__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .what__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-slate-900);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .what__title {
      font-size: var(--text-4xl);
    }
  }

  .what__description {
    color: var(--color-slate-600);
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  /* Grid */
  .what__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .what__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Image */
  .what__image-wrap {
    position: relative;
  }

  .what__image-deco {
    position: absolute;
    width: 6rem;
    height: 6rem;
    border-radius: var(--radius-2xl);
    z-index: 0;
  }

  .what__image-deco--tl {
    top: -1rem;
    left: -1rem;
    background-color: var(--color-primary-light);
  }

  .what__image-deco--br {
    bottom: -1rem;
    right: -1rem;
    background-color: rgba(249, 115, 22, 0.1);
  }

  .what__image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
  }

  /* Content */
  .what__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .what__heading {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    font-size: var(--text-2xl);
    color: var(--color-primary);
  }

  .what__body {
    color: var(--color-slate-600);
    line-height: 1.75;
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .what__body {
      font-size: var(--text-base);
    }
  }

  /* Cards */
  .what__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }

  .what__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background-color: var(--color-slate-50);
    border: 1px solid var(--color-slate-100);
    border-radius: var(--radius-xl);
    transition: box-shadow var(--transition-slow);
  }

  .what__card:hover {
    box-shadow: var(--shadow-md);
  }

  .what__card-icon {
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--color-primary-light);
    color: var(--color-primary-mid);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .what__card h4 {
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    color: var(--color-slate-900);
  }

  .what__card p {
    font-size: var(--text-xs);
    color: var(--color-slate-500);
    line-height: 1.6;
    margin-top: var(--space-1);
  }
</style>
