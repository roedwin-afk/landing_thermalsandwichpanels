---
import { Info, Star } from "lucide-astro";
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;

const rows = [
  {
    name: t.comparison.row1Name,
    sub: t.comparison.row1Sub,
    thermal: t.comparison.row1Thermal,
    thermalStars: 2,
    fire: t.comparison.row1Fire,
    fireVariant: "standard",
    cost: t.comparison.row1Cost,
    weight: t.comparison.row1Weight,
    use: t.comparison.row1Use,
  },
  {
    name: t.comparison.row2Name,
    sub: t.comparison.row2Sub,
    thermal: t.comparison.row2Thermal,
    thermalStars: 3,
    fire: t.comparison.row2Fire,
    fireVariant: "good",
    cost: t.comparison.row2Cost,
    weight: t.comparison.row2Weight,
    use: t.comparison.row2Use,
  },
  {
    name: t.comparison.row3Name,
    sub: t.comparison.row3Sub,
    thermal: t.comparison.row3Thermal,
    thermalStars: 2,
    fire: t.comparison.row3Fire,
    fireVariant: "best",
    cost: t.comparison.row3Cost,
    weight: t.comparison.row3Weight,
    use: t.comparison.row3Use,
  },
];
---

<section id="comparativa" class="comparison">
  <div class="container">
    <!-- Header -->
    <div class="comparison__header reveal">
      <span class="section-label">{t.comparison.label}</span>
      <h2 class="comparison__title accent-line-center">{t.comparison.title}</h2>
      <p class="comparison__description">{t.comparison.description}</p>
    </div>

    <!-- Table -->
    <div class="comparison__table-wrap reveal reveal-delay-1">
      <table class="comparison__table">
        <thead>
          <tr>
            <th>{t.comparison.col1}</th>
            <th>{t.comparison.col2}</th>
            <th>{t.comparison.col3}</th>
            <th>{t.comparison.col4}</th>
            <th>{t.comparison.col5}</th>
            <th>{t.comparison.col6}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td>
                  <span class="comparison__row-name">{row.name}</span>
                  <span class="comparison__row-sub">{row.sub}</span>
                </td>
                <td>
                  <div class="comparison__stars">
                    {Array.from({ length: 3 }).map((_, i) => (
                      <Star
                        size={14}
                        class={`comparison__star ${i < row.thermalStars ? "comparison__star--on" : "comparison__star--off"}`}
                        fill="currentColor"
                      />
                    ))}
                    <span class="comparison__thermal-label">{row.thermal}</span>
                  </div>
                </td>
                <td>
                  <span
                    class={`comparison__badge comparison__badge--${row.fireVariant}`}
                  >
                    {row.fire}
                  </span>
                </td>
                <td>
                  <span class="comparison__cost">{row.cost}</span>
                </td>
                <td class="comparison__weight">{row.weight}</td>
                <td class="comparison__use">{row.use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Tip Box -->
    <div class="comparison__tip reveal reveal-delay-2">
      <Info size={24} class="comparison__tip-icon" />
      <div>
        <span class="comparison__tip-label">{t.comparison.tipLabel}</span>
        <p class="comparison__tip-text">{t.comparison.tip}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .comparison {
    padding-block: var(--space-20);
    background-color: var(--color-slate-900);
    color: var(--color-white);
  }

  /* Header */
  .comparison__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .comparison__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-white);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    .comparison__title {
      font-size: var(--text-4xl);
    }
  }

  .comparison__description {
    color: var(--color-slate-400);
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }

  /* Table wrapper */
  .comparison__table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-2xl);
  }

  .comparison__table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    text-align: left;
  }

  .comparison__table thead tr {
    background-color: #1e293b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .comparison__table th {
    padding: var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    letter-spacing: 0.03em;
    color: var(--color-slate-300);
  }

  .comparison__table tbody tr {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: background-color var(--transition-base);
  }

  .comparison__table tbody tr:last-child {
    border-bottom: none;
  }

  .comparison__table tbody tr:nth-child(even) {
    background-color: rgba(255, 255, 255, 0.01);
  }

  .comparison__table tbody tr:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  .comparison__table td {
    padding: var(--space-5);
    font-size: var(--text-sm);
    vertical-align: middle;
  }

  /* Row name */
  .comparison__row-name {
    display: block;
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    color: var(--color-white);
  }

  .comparison__row-sub {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-slate-400);
    margin-top: var(--space-1);
  }

  /* Stars */
  .comparison__stars {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .comparison__star--on {
    color: #f59e0b;
  }

  .comparison__star--off {
    color: #334155;
  }

  .comparison__thermal-label {
    font-size: var(--text-xs);
    color: var(--color-slate-300);
    margin-left: var(--space-2);
  }

  /* Badges */
  .comparison__badge {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .comparison__badge--standard {
    background-color: rgba(127, 29, 29, 0.4);
    color: #fca5a5;
    border: 1px solid rgba(127, 29, 29, 0.6);
  }

  .comparison__badge--good {
    background-color: rgba(20, 83, 45, 0.4);
    color: #86efac;
    border: 1px solid rgba(20, 83, 45, 0.6);
  }

  .comparison__badge--best {
    background-color: rgba(30, 58, 138, 0.4);
    color: #93c5fd;
    border: 1px solid rgba(30, 58, 138, 0.6);
  }

  /* Cost */
  .comparison__cost {
    font-weight: var(--font-semibold);
    color: var(--color-accent);
  }

  /* Weight & Use */
  .comparison__weight,
  .comparison__use {
    color: var(--color-slate-300);
  }

  /* Tip box */
  .comparison__tip {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    max-width: 56rem;
    margin-inline: auto;
    margin-top: var(--space-8);
  }

  .comparison__tip-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .comparison__tip-label {
    display: block;
    font-weight: var(--font-bold);
    color: var(--color-white);
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
  }

  .comparison__tip-text {
    color: var(--color-slate-300);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
</style>
