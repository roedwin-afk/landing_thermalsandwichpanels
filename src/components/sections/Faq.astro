---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import { ChevronDown } from "lucide-astro";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;

const items = [
  { q: t.faq.q1, a: t.faq.a1 },
  { q: t.faq.q2, a: t.faq.a2 },
  { q: t.faq.q3, a: t.faq.a3 },
  { q: t.faq.q4, a: t.faq.a4 },
];
---

<section id="faq" class="faq">
  <div class="container">

    <!-- Header -->
    <div class="faq__header reveal">
      <span class="section-label">{t.faq.label}</span>
      <h2 class="faq__title accent-line-center">{t.faq.title}</h2>
      <p class="faq__description">{t.faq.description}</p>
    </div>

    <!-- Accordion -->
    <div class="faq__list">
      {items.map((item, i) => (
        <div class={`faq__item reveal reveal-delay-${i + 1}`} data-faq>
          <button class="faq__question" aria-expanded="false">
            <span>{item.q}</span>
            <ChevronDown size={18} class="faq__icon" />
          </button>
          <div class="faq__answer">
            <div class="faq__answer-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initFaq() {
    const items = document.querySelectorAll("[data-faq]");
    const list = document.querySelector(".faq__list") as HTMLElement;
    if (!items.length || !list) return;

    // Abrir todos temporalmente para medir el alto máximo
    function fixListHeight() {
      let maxHeight = 0;

      items.forEach((item) => {
        const answer = item.querySelector(".faq__answer") as HTMLElement;
        const question = item.querySelector(".faq__question") as HTMLElement;
        if (!answer || !question) return;

        // Medir con el item abierto
        answer.style.transition = "none";
        answer.style.maxHeight = answer.scrollHeight + "px";
        const total = (item as HTMLElement).offsetHeight;
        answer.style.maxHeight = "0px";

        if (total > maxHeight) maxHeight = total;
      });

      // Alto total = todos los items cerrados + gaps + el item más alto abierto
      const closedItemsHeight = Array.from(items).reduce((acc, item) => {
        const question = item.querySelector(".faq__question") as HTMLElement;
        return acc + (question?.offsetHeight || 0);
      }, 0);

      const gap = 16; // --space-4
      const totalGaps = (items.length - 1) * gap;

      list.style.minHeight = closedItemsHeight + totalGaps + maxHeight + "px";

      // Restaurar transiciones
      requestAnimationFrame(() => {
        items.forEach((item) => {
          const answer = item.querySelector(".faq__answer") as HTMLElement;
          if (answer) answer.style.transition = "";
        });
      });
    }

    function openItem(item: Element) {
      const btn = item.querySelector(".faq__question") as HTMLButtonElement;
      const answer = item.querySelector(".faq__answer") as HTMLElement;
      if (!btn || !answer) return;
      btn.setAttribute("aria-expanded", "true");
      item.classList.add("faq__item--open");
      answer.style.maxHeight = answer.scrollHeight + "px";
    }

    function closeItem(item: Element) {
      const btn = item.querySelector(".faq__question") as HTMLButtonElement;
      const answer = item.querySelector(".faq__answer") as HTMLElement;
      if (!btn || !answer) return;
      answer.style.transition = "none";
      answer.style.maxHeight = "0px";
      btn.setAttribute("aria-expanded", "false");
      item.classList.remove("faq__item--open");
      requestAnimationFrame(() => {
        answer.style.transition = "";
      });
    }

    items.forEach((item) => {
      const btn = item.querySelector(".faq__question") as HTMLButtonElement;
      if (!btn || btn.dataset.initialized) return;
      btn.dataset.initialized = "true";

      btn.addEventListener("click", () => {
        const isOpen = item.classList.contains("faq__item--open");
        items.forEach((other) => {
          if (other !== item) closeItem(other);
        });
        if (!isOpen) {
          openItem(item);
        } else {
          closeItem(item);
        }
      });
    });

    // Fijar alto y abrir primero
    requestAnimationFrame(() => {
      fixListHeight();
      if (!items[0].classList.contains("faq__item--open")) {
        openItem(items[0]);
      }
    });
  }

  initFaq();
  document.addEventListener("astro:page-load", initFaq);
</script>

<style>
  .faq {
    padding-block: var(--space-20);
    background-color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .faq {
      padding-block: var(--space-28);
    }
  }

  /* Header */
  .faq__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .faq__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-slate-900);
    margin-top: var(--space-2);
  }

  .faq__description {
    color: var(--color-slate-500);
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }

  /* List */
  .faq__list {
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 420px;
  }

  /* Item */
  .faq__item {
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-slate-50);
    transition: border-color var(--transition-slow);
  }

  .faq__item--open {
    border-color: var(--color-primary-mid);
  }

  /* Question button */
  .faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    text-align: left;
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    color: var(--color-slate-900);
    transition: color var(--transition-base);
  }

  .faq__question:hover {
    color: var(--color-primary-mid);
  }

  .faq__item--open .faq__question {
    color: var(--color-primary-mid);
  }

  /* Chevron icon */
  .faq__icon {
    flex-shrink: 0;
    transition: transform var(--transition-slow);
  }

  .faq__item--open .faq__icon {
    transform: rotate(180deg);
  }

  /* Answer */
  .faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq__answer-inner {
    padding: var(--space-5);
    padding-top: 0;
    border-top: 1px solid var(--color-slate-100);
    background-color: var(--color-white);
  }

  .faq__answer-inner p {
    color: var(--color-slate-600);
    font-size: var(--text-sm);
    line-height: 1.75;
    padding-top: var(--space-5);
  }
</style>