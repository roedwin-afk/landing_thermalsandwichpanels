---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;

const items = [
  { q: t.faq.q1, a: t.faq.a1 },
  { q: t.faq.q2, a: t.faq.a2 },
  { q: t.faq.q3, a: t.faq.a3 },
  { q: t.faq.q4, a: t.faq.a4 },
];
---

<section id="faq" class="faq">
  <div class="container">

    <!-- Header -->
    <div class="faq__header reveal">
      <span class="section-label">{t.faq.label}</span>
      <h2 class="faq__title accent-line-center">{t.faq.title}</h2>
      <p class="faq__description">{t.faq.description}</p>
    </div>

    <!-- Accordion -->
    <div class="faq__list">
      {items.map((item, i) => (
        <div class={`faq__item reveal reveal-delay-${i + 1}`} data-faq>
          <button class="faq__question" aria-expanded="false">
            <span>{item.q}</span>
            <svg
              class="faq__icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="faq__answer">
            <div class="faq__answer-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initFaq() {
    const items = document.querySelectorAll("[data-faq]");
    if (!items.length) return;

    items.forEach((item) => {
      // Clonar el botón para eliminar listeners anteriores
      const oldBtn = item.querySelector(".faq__question");
      if (!oldBtn) return;
      const btn = oldBtn.cloneNode(true) as HTMLButtonElement;
      oldBtn.parentNode?.replaceChild(btn, oldBtn);

      const answer = item.querySelector(".faq__answer") as HTMLElement;

      btn.addEventListener("click", () => {
        const isOpen = item.classList.contains("faq__item--open");

        // Cerrar todos
        items.forEach((other) => {
          const otherBtn = other.querySelector(".faq__question") as HTMLButtonElement;
          const otherAnswer = other.querySelector(".faq__answer") as HTMLElement;
          otherBtn?.setAttribute("aria-expanded", "false");
          other.classList.remove("faq__item--open");
          if (otherAnswer) otherAnswer.style.maxHeight = "0px";
        });

        // Abrir el actual si estaba cerrado
        if (!isOpen) {
          btn.setAttribute("aria-expanded", "true");
          item.classList.add("faq__item--open");
          if (answer) answer.style.maxHeight = answer.scrollHeight + "px";
        }
      });
    });

    // Abrir el primero por defecto
    const first = items[0];
    if (first) {
      const btn = first.querySelector(".faq__question") as HTMLButtonElement;
      const answer = first.querySelector(".faq__answer") as HTMLElement;
      btn?.setAttribute("aria-expanded", "true");
      first.classList.add("faq__item--open");
      if (answer) {
        // Pequeño delay para que el DOM calcule el scrollHeight correctamente
        requestAnimationFrame(() => {
          answer.style.maxHeight = answer.scrollHeight + "px";
        });
      }
    }
  }

  document.addEventListener("astro:page-load", initFaq);
  document.addEventListener("DOMContentLoaded", initFaq);
</script>

<style>
  .faq {
    padding-block: var(--space-20);
    background-color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .faq {
      padding-block: var(--space-28);
    }
  }

  /* Header */
  .faq__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .faq__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-slate-900);
    margin-top: var(--space-2);
  }

  .faq__description {
    color: var(--color-slate-500);
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }

  /* List */
  .faq__list {
    max-width: 48rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Item */
  .faq__item {
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-slate-50);
    transition: border-color var(--transition-slow);
  }

  .faq__item--open {
    border-color: var(--color-primary-mid);
  }

  /* Question button */
  .faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    text-align: left;
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    color: var(--color-slate-900);
    transition: color var(--transition-base);
  }

  .faq__question:hover {
    color: var(--color-primary-mid);
  }

  .faq__item--open .faq__question {
    color: var(--color-primary-mid);
  }

  /* Chevron icon */
  .faq__icon {
    flex-shrink: 0;
    transition: transform var(--transition-slow);
  }

  .faq__item--open .faq__icon {
    transform: rotate(180deg);
  }

  /* Answer */
  .faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-slow) ease;
  }

  .faq__answer-inner {
    padding: var(--space-5);
    padding-top: 0;
    border-top: 1px solid var(--color-slate-100);
    background-color: var(--color-white);
  }

  .faq__answer-inner p {
    color: var(--color-slate-600);
    font-size: var(--text-sm);
    line-height: 1.75;
    padding-top: var(--space-5);
  }
</style>