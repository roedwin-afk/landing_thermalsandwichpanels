---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import { ChevronDown, ArrowRight } from "lucide-astro";
import { localizedPath } from "../../i18n/utils";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;

const items = [
  { q: t.faq.q1, a: t.faq.a1 },
  { q: t.faq.q2, a: t.faq.a2 },
  { q: t.faq.q3, a: t.faq.a3 },
  { q: t.faq.q4, a: t.faq.a4 },
];

const base = import.meta.env.BASE_URL;
---

<section id="faq" class="faq">
  <div class="container">
    <!-- Header -->
    <div class="faq__header reveal">
      <span class="section-label">{t.faq.label}</span>
      <h2 class="faq__title accent-line-center">{t.faq.title}</h2>
      <p class="faq__description">{t.faq.description}</p>
    </div>

    <!-- Accordion -->
    <div class="faq__list">
      {
        items.map((item, i) => (
          <div class={`faq__item reveal reveal-delay-${i + 1}`} data-faq>
            <button class="faq__question" aria-expanded="false">
              <span>{item.q}</span>
              <ChevronDown size={18} class="faq__icon" />
            </button>
            <div class="faq__answer">
              <div class="faq__answer-inner">
                <p>{item.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- View All Link -->
    <div class="faq__footer reveal">
      
      <!-- <a href={lang === "en"
          ? `${import.meta.env.BASE_URL}faq`
          : `${import.meta.env.BASE_URL}es/faq`}
        class="faq__view-all"
      > -->
      <a href={localizedPath(lang, "faq", base)}
        class="faq__view-all"
      >
        {t.faq.viewAll}
        <ArrowRight size={16} />
      </a>
    </div>
  </div>
</section>

<script>
  function initFaq() {
    // Evitar doble inicialización
    const list = document.querySelector(".faq__list") as HTMLElement;
    if (!list || list.dataset.faqInit === "true") return;
    list.dataset.faqInit = "true";

    const items = document.querySelectorAll("[data-faq]");
    if (!items.length) return;

    function openItem(item: Element) {
      const btn = item.querySelector(".faq__question") as HTMLButtonElement;
      const answer = item.querySelector(".faq__answer") as HTMLElement;
      if (!btn || !answer) return;
      btn.setAttribute("aria-expanded", "true");
      item.classList.add("faq__item--open");
      answer.style.maxHeight = answer.scrollHeight + "px";
    }

    function closeItem(item: Element) {
      const btn = item.querySelector(".faq__question") as HTMLButtonElement;
      const answer = item.querySelector(".faq__answer") as HTMLElement;
      if (!btn || !answer) return;
      answer.style.maxHeight = "0px";
      btn.setAttribute("aria-expanded", "false");
      item.classList.remove("faq__item--open");
    }

    function fixListHeight() {
      let maxAnswerHeight = 0;

      items.forEach((item) => {
        const answer = item.querySelector(".faq__answer") as HTMLElement;
        if (!answer) return;
        const isOpen = item.classList.contains("faq__item--open");

        // Medir sin alterar el estado visual
        const prev = answer.style.maxHeight;
        answer.style.maxHeight = "9999px";
        const h = answer.scrollHeight;
        answer.style.maxHeight = isOpen ? answer.scrollHeight + "px" : prev;

        if (h > maxAnswerHeight) maxAnswerHeight = h;
      });

      const closedHeight = Array.from(items).reduce((acc, item) => {
        const q = item.querySelector(".faq__question") as HTMLElement;
        return acc + (q?.offsetHeight || 0);
      }, 0);

      const gap = 16;
      const totalGaps = (items.length - 1) * gap;
      list.style.minHeight = closedHeight + totalGaps + maxAnswerHeight + "px";
    }

    // Registrar listeners
    items.forEach((item) => {
      const btn = item.querySelector(".faq__question") as HTMLButtonElement;
      if (!btn) return;
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        const isOpen = item.classList.contains("faq__item--open");
        items.forEach((other) => { if (other !== item) closeItem(other); });
        isOpen ? closeItem(item) : openItem(item);
      });
    });

    // Abrir el primero después del reveal
    const firstItem = document.querySelector("[data-faq]") as HTMLElement;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        setTimeout(() => {
          openItem(firstItem);
          fixListHeight();
        }, 650);
      });
    }, { threshold: 0.1 });

    observer.observe(firstItem);
  }

  // Un solo punto de entrada — astro:page-load dispara en carga inicial y navegación
  document.addEventListener("astro:page-load", initFaq);
</script>

<style>
  .faq {
    padding-block: var(--space-20);
    background-color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .faq {
      padding-block: var(--space-28);
    }
  }

  .faq__header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: var(--space-16);
  }

  .faq__title {
    font-family: var(--font-heading);
    font-weight: var(--font-extrabold);
    font-size: var(--text-3xl);
    color: var(--color-slate-900);
    margin-top: var(--space-2);
  }

  .faq__description {
    color: var(--color-slate-500);
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }

  .faq__list {
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 420px;
  }

  .faq__item {
    border: 1px solid var(--color-slate-200);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-slate-50);
    transition: border-color var(--transition-slow);
  }

  .faq__item--open {
    border-color: var(--color-primary-mid);
  }

  .faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    text-align: left;
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    color: var(--color-slate-900);
    transition: color var(--transition-base);
  }

  .faq__question:hover {
    color: var(--color-primary-mid);
  }

  .faq__item--open .faq__question {
    color: var(--color-primary-mid);
  }

  .faq__icon {
    flex-shrink: 0;
    transition: transform var(--transition-slow);
  }

  .faq__item--open .faq__icon {
    transform: rotate(180deg);
  }

  .faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq__answer-inner {
    padding: var(--space-5);
    padding-top: 0;
    border-top: 1px solid var(--color-slate-100);
    background-color: var(--color-white);
  }

  .faq__answer-inner p {
    color: var(--color-slate-600);
    font-size: var(--text-sm);
    line-height: 1.75;
    padding-top: var(--space-5);
  }

  .faq__footer {
    text-align: center;
    margin-top: var(--space-10);
  }

  .faq__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-primary-mid);
    transition:
      color var(--transition-base),
      gap var(--transition-base);
  }

  .faq__view-all:hover {
    color: var(--color-accent);
    gap: var(--space-3);
  }
</style>